{
  "name": "learn-deepseek-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.demo.json",
    "check": "tsc --ignoreConfig scripts/check-lessons.ts --outDir .cache/lesson-check --module commonjs --target es2022 --skipLibCheck && node -e \"require('fs').writeFileSync('.cache/lesson-check/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node .cache/lesson-check/scripts/check-lessons.js",
    "demo": "node --experimental-strip-types demo/mini-harness/main.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
